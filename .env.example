# Real Circle wallet reads and PAJ bank verification. Cashout settlement is unfinished.
# Use OFFRAMP_MODE=demo only to explicitly run the development simulator.
OFFRAMP_MODE=live
# OFFRAMP_DATA_DIR=/absolute/path/to/private/data
OFFRAMP_MAX_USDC=100

# Existing Circle Agent Wallet connection. No private key or destination address prompt.
# CIRCLE_BIN=circle
# CIRCLE_ARC_ADDRESS=0xYourCircleAgentWallet

# Provider checks and one-time local login. These do not enable live cashouts.
PAJ_ENVIRONMENT=production
ARC_NETWORK=mainnet
# Obtain your own Business API key at https://developer.paj.cash/.
# PAJ_API_KEY=
# PAJ_EMAIL=
# Optional alternative to the private session saved by provider:login:
# PAJ_SESSION_TOKEN=

# Wallet login is performed with Circle's CLI. Never put private keys here.
