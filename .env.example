# Default is a fully simulated flow. No wallet, provider login, or real payout.
OFFRAMP_MODE=demo
# OFFRAMP_DATA_DIR=/absolute/path/to/private/data
OFFRAMP_MAX_USDC=100

# Live configuration; see docs/live-integration.md before enabling.
# OFFRAMP_MODE=live
# CIRCLE_BIN=circle
# CIRCLE_ARC_ADDRESS=0xYourCircleAgentWallet
# PAJ_SESSION_TOKEN=
# Set only after verifying that your PAJ integration credits Gateway mints.
# PAJ_GATEWAY_SETTLEMENT_VERIFIED=false
# PAJ_MIN_NGN=1000
# PAJ_MAX_NGN=5000000

# Wallet login is performed with Circle's CLI. Never put private keys here.
