# Arc USDC → NGN payments. Transfers require human approval.
# OFFRAMP_DATA_DIR=/absolute/path/to/private/data
OFFRAMP_MAX_USDC=100
# Retained for estimated Arc gas; the Circle CLI does not impose a hard gas cap.
OFFRAMP_NETWORK_FEE_RESERVE_USDC=0.05

# Existing Circle Agent Wallet connection.
# CIRCLE_BIN=circle
# CIRCLE_ARC_ADDRESS=0xYourCircleAgentWallet

# PAJ Business API key: https://developer.paj.cash/
PAJ_ENVIRONMENT=production
ARC_NETWORK=mainnet
# PAJ_API_KEY=

# Authenticate with the Circle CLI. Never put private keys in this file.
