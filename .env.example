# Default is a fully simulated flow. No wallet, provider login, or real payout.
OFFRAMP_MODE=demo
# OFFRAMP_DATA_DIR=/absolute/path/to/private/data
OFFRAMP_MAX_USDC=100

# Optional diagnostics for the future live integration. These do not enable payouts.
# Live mode is unavailable in this release; see docs/live-integration.md.
# CIRCLE_BIN=circle
# CIRCLE_ARC_ADDRESS=0xYourCircleAgentWallet

# Wallet login is performed with Circle's CLI. Never put private keys here.
