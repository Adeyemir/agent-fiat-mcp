# Arc USDC → NGN payments through the hosted service. Transfers require human approval.
# No PAJ key is needed. The service creates private connection credentials automatically.
# Set OFFRAMP_DATA_DIR in the launching environment to select a different profile.
OFFRAMP_MAX_USDC=100
# Retained for estimated Arc gas; the Circle CLI does not impose a hard gas cap.
OFFRAMP_NETWORK_FEE_RESERVE_USDC=0.05

# Existing Circle Agent Wallet connection.
# CIRCLE_BIN=circle
# CIRCLE_ARC_ADDRESS=0xYourCircleAgentWallet

ARC_NETWORK=mainnet
# Optional: use your own hosted backend. HTTPS origin, without a path.
# OFFRAMP_BACKEND_URL=https://your-service.example.com

# Authenticate with the Circle CLI. Never put private keys in this file.
