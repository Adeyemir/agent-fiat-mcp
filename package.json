{
  "name": "naira-offramp-mcp",
  "version": "0.2.2",
  "description": "Let AI agents pay Nigerian bank accounts from Circle Agent Wallet USDC on Arc.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Adeyemir/naira-offramp-mcp#readme",
  "bugs": {
    "url": "https://github.com/Adeyemir/naira-offramp-mcp/issues"
  },
  "keywords": [
    "mcp",
    "circle",
    "arc",
    "usdc",
    "ngn",
    "payments",
    "paj"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "naira-offramp-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".env.example",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "check": "tsc --project tsconfig.test.json",
    "start": "node --env-file-if-exists=.env dist/cli.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx src/cli.ts doctor",
    "provider:check": "node --env-file-if-exists=.env --import tsx src/cli.ts provider-check",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:package": "npm run build && node scripts/smoke-package.mjs",
    "backend:types": "wrangler types backend/worker-configuration.d.ts --config backend/wrangler.jsonc --include-runtime=false --strict-vars=false",
    "backend:check": "tsc --project backend/tsconfig.json",
    "backend:build": "wrangler deploy --config backend/wrangler.jsonc --dry-run --outdir ../backend-dist",
    "backend:test": "npm run backend:build && node --import tsx --test tests/backend.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "viem": "^2.38.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^22.0.0",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^5.20261019.1-beta",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adeyemir/naira-offramp-mcp.git"
  }
}
