{
  "name": "naira-offramp-mcp",
  "version": "0.1.0",
  "description": "Let AI agents pay Nigerian bank accounts from Circle Agent Wallet USDC on Arc.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "naira-offramp-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".env.example",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "check": "tsc --project tsconfig.test.json",
    "start": "node --env-file-if-exists=.env dist/cli.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx src/cli.ts doctor",
    "provider:check": "node --env-file-if-exists=.env --import tsx src/cli.ts provider-check",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "viem": "^2.38.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adeyemir/naira-offramp-mcp.git"
  }
}
