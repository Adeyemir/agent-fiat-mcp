{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "naira-offramp-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naira-offramp-api",
      "database_id": "ec74843e-02fb-45f4-a7ab-e327627c4868",
      "migrations_dir": "migrations",
    },
  ],
  "secrets": { "required": ["PAJ_API_KEY", "IP_HASH_SECRET"] },
  "vars": {
    "REQUESTS_PER_MINUTE": "60",
    "REQUESTS_PER_IP_MINUTE": "120",
    "REQUESTS_PER_DAY": "5000",
    "ORDERS_PER_INSTALLATION_DAY": "20",
    "ORDERS_PER_IP_DAY": "50",
    "ORDERS_PER_DAY": "200",
    "MAX_ORDER_USDC": "100",
    "MAX_ORDER_NGN": "500000",
  },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false },
  },
}
